/**
 * Pushes the ration-only dishes (src/data/rationSeed.ts) into Supabase `partner_products`
 * with target_channels = ["site"] — they show up in the admin panel under "site rations" and
 * never in the hall (POS) showcase. Safe to re-run: rows are upserted by id.
 *
 * Only dishes that are MISSING from the database are written (--write); existing ones — with their photos
 * and anything edited in the admin panel — are never touched. New dishes start with no photo.
 *
 *   node --experimental-strip-types scripts/seed_ration_dishes.mts          # dry run: lists what is new
 *   node --experimental-strip-types scripts/seed_ration_dishes.mts --write  # really write
 *   node --experimental-strip-types scripts/seed_ration_dishes.mts --sql    # writes supabase/seed_ration_dishes.sql
 *                                                                           # (paste it into the Supabase SQL editor)
 *   add --snacks to work with the snack rows only
 */
import fs from 'node:fs';
import { rationSeedRows as allRows, snackSeedRows } from '../src/data/rationSeed.ts';

const rows = process.argv.includes('--snacks') ? snackSeedRows : allRows;

const env = Object.fromEntries(
  fs.readFileSync('.env.local', 'utf8').split(/\r?\n/)
    .filter(l => l.includes('=') && !l.startsWith('#'))
    .map(l => [l.slice(0, l.indexOf('=')), l.slice(l.indexOf('=') + 1).trim().replace(/^["']|["']$/g, '')])
);
const url = env.NEXT_PUBLIC_SUPABASE_URL;
const key = env.NEXT_PUBLIC_SUPABASE_ANON_KEY;
const headers = { apikey: key, Authorization: `Bearer ${key}`, 'Content-Type': 'application/json' };
const write = process.argv.includes('--write');

if (process.argv.includes('--sql')) {
  const q = (v: string) => `'${v.replace(/'/g, "''")}'`;
  const j = (v: unknown) => `${q(JSON.stringify(v))}::jsonb`;
  const lines = rows.map(r =>
    `  (${[
      q(r.id), q(r.slug), j(r.name), j(r.description), q(r.category), j(r.category_name), q(r.meal_type), q(r.day),
      r.price, r.cost_price, r.calories, r.protein, r.fat, r.carbs, r.weight_grams, q(''),
      j(r.ingredients), j(r.allergens), q(r.cooking_method), j(r.target_channels),
    ].join(', ')})`
  );
  const sql = `-- Ration-only dishes (channel "site" — never in the hall showcase). Safe to re-run:
-- an existing dish keeps its photo (the photo column is not in the UPDATE list).
-- Generated by scripts/seed_ration_dishes.mts from src/data/rationSeed.ts
INSERT INTO partner_products
  (id, slug, name, description, category, category_name, meal_type, day, price, cost_price, calories, protein, fat, carbs, weight_grams, image, ingredients, allergens, cooking_method, target_channels)
VALUES
${lines.join(',' + String.fromCharCode(10))}
ON CONFLICT (id) DO UPDATE SET
  slug = EXCLUDED.slug, name = EXCLUDED.name, description = EXCLUDED.description, category = EXCLUDED.category,
  category_name = EXCLUDED.category_name, meal_type = EXCLUDED.meal_type, day = EXCLUDED.day,
  calories = EXCLUDED.calories, protein = EXCLUDED.protein, fat = EXCLUDED.fat, carbs = EXCLUDED.carbs,
  weight_grams = EXCLUDED.weight_grams, ingredients = EXCLUDED.ingredients,
  allergens = EXCLUDED.allergens, target_channels = EXCLUDED.target_channels;
`;
  fs.writeFileSync('supabase/seed_ration_dishes.sql', sql);
  console.log(`Wrote supabase/seed_ration_dishes.sql (${rows.length} dishes)`);
  process.exit(0);
}

// Which dishes are already in the database?
const have = await fetch(`${url}/rest/v1/partner_products?select=id`, { headers });
if (!have.ok) {
  console.error(`Could not read the database: ${have.status} ${await have.text()}`);
  process.exit(1);
}
const existing = new Set<string>((await have.json()).map((r: { id: string }) => r.id));
const fresh = rows.filter(r => !existing.has(r.id));
const known = rows.length - fresh.length;

console.log(`${rows.length} dishes in the seed: ${fresh.length} new, ${known} already in the database`);
for (const r of fresh) console.log(` NEW  ${r.day} ${r.meal_type.padEnd(9)} ${String(r.calories).padStart(3)} kcal  ${r.slug}`);
if (!write) {
  console.log('\nDry run — add --write to upsert into partner_products.');
  process.exit(0);
}

async function upsert(list: unknown[], what: string) {
  if (!list.length) return;
  const res = await fetch(`${url}/rest/v1/partner_products?on_conflict=id`, {
    method: 'POST',
    headers: { ...headers, Prefer: 'resolution=merge-duplicates,return=minimal' },
    body: JSON.stringify(list),
  });
  console.log(res.ok ? `${what}: ${list.length} rows written.` : `${what}: FAILED ${res.status}: ${await res.text()}`);
}

// Only dishes that are missing are written: anything already in the database (and edited in the admin panel) is left alone.
// New dishes start without a photo.
await upsert(fresh, 'new dishes');
